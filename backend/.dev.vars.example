# Local development settings. Copy to backend/.dev.vars (which is gitignored).
# `wrangler dev` loads .dev.vars and it overrides [vars] in wrangler.toml.

# Ollama's OpenAI-compatible API
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3
EMBEDDING_MODEL=nomic-embed-text
# Lowest similarity score shown as a source; nomic-embed-text scores lower than the production model
CITATION_MIN_SCORE=0.48

# Cloudflare Access is bypassed locally; every request runs as dev@localhost
AUTH_ENABLED=false

# Vectors are kept in the local D1 database instead of Vectorize
VECTOR_STORE=local

# Per-user limits are lifted locally so development and testing are not interrupted
MAX_NOTES_PER_USER=1000
MAX_CHUNKS_PER_USER=100000
MAX_QUESTIONS_PER_DAY=100000

# Origin of the Vite dev server
ALLOWED_ORIGIN=http://localhost:5173
